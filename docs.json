    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "description": "Welcome to CSVbox documentation and help site!",
  "redirects": [
    {
      "source": "/master",
      "destination": "/"
    },
    {
      "source": "/getting-started/1.-add-template",
      "destination": "/getting-started/1-add-template"
    },
    {
      "source": "/getting-started/2.-install-code",
      "destination": "/getting-started/2-install-code"
    },
    {
      "source": "/getting-started/3.-receive-data",
      "destination": "/getting-started/3-receive-data"
    },
    {
      "source": "/destinations/bubble.io",
      "destination": "/destinations/bubble-io"
    },
    {
      "source": "/getting-started/sheet-options",
      "destination": "/dashboard-settings/sheet-options"
    },
    {
      "source": "/getting-started/sheet-options-1",
      "destination": "/dashboard-settings/sheet-options-1"
    },
    {
      "source": "/getting-started/validations",
      "destination": "/dashboard-settings/validations"
    },
    {
      "source": "/getting-started/styling",
      "destination": "/dashboard-settings/styling"
    },
    {
      "source": "/changelog",
      "destination": "/change-log",
      "permanent": true
    },
    {
      "source": "/advanced-installation/csvbox-mcp-server",
      "destination": "/advanced-installation/mcp-server"
    },
    {
      "source": "/dashboard-settings/advanced-options",
      "destination": "/dashboard-settings/sheet-options-1"
    },
    {
      "source": "/validations",
      "destination": "/dashboard-settings/validations"
    },
    {
      "source": "/getting-started/add-columns-via-csv",
      "destination": "/dashboard-settings/add-columns-via-csv"
    },
    {
      "source": "/getting-started/dynamic-columns",
      "destination": "/advanced-installation/dynamic-columns"
    },
    {
      "source": "/advanced-installation/multipart-uploads",
      "destination": "/advanced-installation/rest-file-api#direct-file-upload"
    }
  ],
  "interaction": {
    "drilldown": true
  },
  "seo": {
    "metatags": {
      "canonical": "https://csvbox-io.mintlify.site",
      "og:image": "https://csvbox.io/og/default.png",
      "twitter:site": "@csvboxio"
    }
