    "links": [
      {
        "href": "https://csvbox.canny.io/feature-requests",
        "label": "Suggestions"
      },
      {
        "href": "/change-log",
        "label": "Changelog"
      },
      {
        "href": "https://share.hsforms.com/1ubpg6RBoQgKOISkRMEViwg5auur",
        "label": "Contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://app.csvbox.io/"
    }
  },
