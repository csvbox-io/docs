{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "CSVbox",
  "colors": {
    "primary": "#007BFF",
    "light": "#E8F2FF",
    "dark": "#007BFF"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "navigation": {
    "groups": [
      {
        "group": "Home",
        "icon": "house",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": [
          "getting-started",
          "getting-started/1-add-template"
        ]
      },
      {
        "group": "Dashboard Settings",
        "icon": "sliders",
        "pages": []
      },
      {
        "group": "Advanced Installation",
        "icon": "code",
        "pages": []
      },
      {
        "group": "Data Destinations",
        "icon": "database",
        "pages": []
      },
      {
        "group": "Account",
        "icon": "user",
        "pages": []
      },
      {
        "group": "Resources",
        "icon": "book",
        "pages": []
      },
      {
        "group": "Legal",
        "icon": "scale-balanced",
        "pages": []
      }
    ]
  },
  "logo": {
    "light": "/images/image(25).png",
    "dark": "/images/image(25).png",
    "href": "https://csvbox.io"
  },
  "navbar": {
    "links": [
      {
        "href": "https://csvbox.io",
        "label": "Website"
      },
      {
        "href": "https://csvbox.canny.io/feature-requests",
        "label": "Suggestions"
      },
      {
        "href": "https://share.hsforms.com/1ubpg6RBoQgKOISkRMEViwg5auur",
        "label": "Contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "redirects": [
    {
      "source": "/master",
      "destination": "/"
    },
    {
      "source": "/getting-started/1.-add-template",
      "destination": "/getting-started/1-add-template"
    },
    {
      "source": "/getting-started/2.-install-code",
      "destination": "/getting-started/2-install-code"
    },
    {
      "source": "/getting-started/3.-receive-data",
      "destination": "/getting-started/3-receive-data"
    },
    {
      "source": "/destinations/bubble.io",
      "destination": "/destinations/bubble-io"
    },
    {
      "source": "/getting-started/sheet-options",
      "destination": "/dashboard-settings/sheet-options"
    },
    {
      "source": "/getting-started/sheet-options-1",
      "destination": "/dashboard-settings/sheet-options-1"
    },
    {
      "source": "/getting-started/validations",
      "destination": "/dashboard-settings/validations"
    },
    {
      "source": "/getting-started/styling",
      "destination": "/dashboard-settings/styling"
    }
  ]
}
